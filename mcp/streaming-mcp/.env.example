# Copy to .env and fill in.
GEMINI_API_KEY=your_key_here

# Optional - defaults to gemini-2.5-flash
# GEMINI_MODEL=gemini-2.5-flash

# Streamable HTTP MCP endpoint.
PARENT_MCP_URL=http://127.0.0.1:8000/mcp
PARENT_MCP_SERVER_HOST=127.0.0.1
PARENT_MCP_SERVER_PORT=8000
PARENT_MCP_SERVER_PATH=/mcp

# Separate Streamable HTTP server used by run_downstream_react_agent.
CHILD_MCP_URL=http://127.0.0.1:8001/mcp
CHILD_MCP_SERVER_HOST=127.0.0.1
CHILD_MCP_SERVER_PORT=8001
CHILD_MCP_SERVER_PATH=/mcp
# Set a shorter delay only when running local automated checks.
# CHILD_MCP_STEP_DELAY_SECONDS=0.1
